# Copy to backend/.env and fill in. Never commit .env.

# Neon connection string (Dashboard -> Connection Details). Keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/ekko?sslmode=require

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://www.reddit.com/prefs/apps  (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ekko/0.1 by u/your_username

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
JWT_SECRET=

# Comma-separated. Add your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173
